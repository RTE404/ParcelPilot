GOOGLE_GENERATIVE_AI_API_KEY=
# Optional — only set locally when demoing observability; unset means traceSpan() is a no-op.
EVAL_ENDPOINT=
EVAL_API_KEY=
# Signs tool-approval requests so a forged request body can't execute an action tool without a
# real approval round-trip — see final-review finding I2. Falls back to a documented dev secret
# in app/api/chat/route.ts if unset.
TOOL_APPROVAL_SECRET=
